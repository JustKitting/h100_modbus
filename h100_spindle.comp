component h100_spindle "Fail-stopped LinuxCNC sequencer for an H100 spindle over hm2_modbus";

option singleton yes;

pin in bit machine_enabled = false "LinuxCNC motion is enabled";
pin in bit run_request = false "LinuxCNC spindle.0.on request";
pin in bit forward_request = false "LinuxCNC spindle.0.forward request";
pin in bit reverse_request = false "LinuxCNC spindle.0.reverse request";
pin in float speed_command_rpm = 0.0 "Absolute LinuxCNC spindle speed command in RPM";
pin in bit reset = false "Rising edge clears a latched sequencer fault while stopped";

pin in bit link_fault = true "hm2_modbus global fault";
pin in bit command_disabled#[13] "Persistent disabled state for every command in the 13-command MBCCB";
pin in u32 control_mode_f001 = 0 "Observed H100 F001";
pin in u32 frequency_source_f002 = 0 "Observed H100 F002";
pin in u32 reference_f004_centihz = 0 "Observed raw H100 F004 parameter value (0.1 Hz units on this VFD)";
pin in u32 maximum_f005_centihz = 0 "Observed raw H100 F005 parameter value (0.1 Hz units on this VFD)";
pin in u32 lower_limit_f011_centihz = 0 "Observed raw H100 F011 parameter value (0.1 Hz units on this VFD)";
pin in u32 panel_stop_f024 = 0 "Observed H100 F024";
pin in u32 slave_address_f163 = 0 "Observed H100 F163";
pin in u32 baud_selector_f164 = 0 "Observed H100 F164";
pin in u32 data_mode_f165 = 0 "Observed H100 F165";
pin in u32 frequency_decimals_f169 = 0 "Observed H100 F169";
pin in u32 output_frequency_decihz = 0 "Observed H100 input register 0000H in 0.1 Hz";
pin in u32 current_fault = 0 "Observed H100 input register 000AH";
pin in u32 main_status = 0 "Observed H100 holding register 0210H";
pin in u32 given_frequency_readback = 0 "Observed H100 holding register 0201H";

param rw float rated_rpm = 24000.0 "Rated spindle RPM from the DMC2 Mini specification";
param rw float minimum_rpm = 0.0 "Explicit permitted minimum RPM; zero keeps run disabled";
param rw float maximum_rpm = 24000.0 "Explicit permitted maximum RPM";
param rw u32 expected_reference_f004_centihz = 0 "Required exact F004 value; zero keeps run disabled";
param rw u32 expected_maximum_f005_centihz = 0 "Required exact F005 value; zero keeps run disabled";
param rw float at_speed_tolerance_hz = 1.0 "Maximum absolute output-frequency error for at-speed";

pin out u32 main_control = 8 "Raw H100 0200H command; 1=RUN, 8=STOP";
pin out u32 given_frequency = 0 "Raw H100 0201H command using observed F169 units";
pin out bit ready = false "All observed and explicit run prerequisites are valid";
pin out bit running = false "H100 main status reports in-operation";
pin out bit forward_running = false "Physical CW/M3 running, using the verified installation mapping";
pin out bit reverse_running = false "Physical CCW/M4 running, using the verified installation mapping";
pin out bit at_speed = true "Stopped, or running forward within configured frequency tolerance";
pin out bit fault_latched = false "A requested or active run violated a prerequisite";
pin out u32 fault_code = 0 "Latched first refusal code; see component source";
pin out u32 block_code = 0 "Current reason run is unavailable; zero means available";
pin out u32 state = 0 "0 stopped, 1 arming, 2 starting, 3 running, 4 stopping, 5 fault";
pin out float speed_feedback_rpm = 0.0 "RPM calculated from H100 output frequency";
pin out float target_frequency_hz = 0.0 "Validated frequency corresponding to the RPM command";

function _;

license "GPL";
author "OpenAI Codex";
description "Sequences frequency verification, documented forward/reverse operation, speed changes, and STOP-before-frequency-clear while refusing unresolved H100 configuration.";
;;

#include "h100_spindle_logic.h"

static struct h100_spindle_context context = {
    H100_STOPPING, 0, 0, H100_BLOCK_NONE, 0, 0.0, 0
};

FUNCTION(_)
{
    struct h100_spindle_input input;
    struct h100_spindle_config config;
    struct h100_spindle_output output;
    int command_index;

    input.i_machine_enabled = machine_enabled;
    input.i_run_request = run_request;
    input.i_forward_request = forward_request;
    input.i_reverse_request = reverse_request;
    input.i_speed_command_rpm = speed_command_rpm;
    input.i_reset = reset;
    input.i_link_fault = link_fault;
    input.i_any_command_disabled = 0;
    for (command_index = 0; command_index < 13; command_index++) {
        if (command_disabled(command_index)) {
            input.i_any_command_disabled = 1;
        }
    }
    input.i_control_mode_f001 = control_mode_f001;
    input.i_frequency_source_f002 = frequency_source_f002;
    input.i_reference_f004_centihz = reference_f004_centihz;
    input.i_maximum_f005_centihz = maximum_f005_centihz;
    input.i_lower_limit_f011_centihz = lower_limit_f011_centihz;
    input.i_panel_stop_f024 = panel_stop_f024;
    input.i_slave_address_f163 = slave_address_f163;
    input.i_baud_selector_f164 = baud_selector_f164;
    input.i_data_mode_f165 = data_mode_f165;
    input.i_frequency_decimals_f169 = frequency_decimals_f169;
    input.i_output_frequency_decihz = output_frequency_decihz;
    input.i_current_fault = current_fault;
    input.i_main_status = main_status;
    input.i_given_frequency_readback = given_frequency_readback;

    config.c_rated_rpm = rated_rpm;
    config.c_minimum_rpm = minimum_rpm;
    config.c_maximum_rpm = maximum_rpm;
    config.c_expected_reference_f004_centihz =
        expected_reference_f004_centihz;
    config.c_expected_maximum_f005_centihz =
        expected_maximum_f005_centihz;
    config.c_at_speed_tolerance_hz = at_speed_tolerance_hz;

    h100_spindle_step(&context, &input, &config, &output);

    main_control = output.o_main_control;
    given_frequency = output.o_given_frequency;
    ready = output.o_ready;
    running = output.o_running;
    forward_running = output.o_forward_running;
    reverse_running = output.o_reverse_running;
    at_speed = output.o_at_speed;
    fault_latched = output.o_fault_latched;
    fault_code = output.o_fault_code;
    block_code = output.o_block_code;
    state = output.o_state;
    speed_feedback_rpm = output.o_speed_feedback_rpm;
    target_frequency_hz = output.o_target_frequency_hz;
}
